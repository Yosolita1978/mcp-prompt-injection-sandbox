# Secrets (SESSION_KEY for agentgateway)
.env
# agentgateway database (request logs), created at runtime
gateway-data/
# Python cache
__pycache__/
# Per-run gateway database and Goose state (big LLM request logs)
runs/*/gateway-data/
runs/*/goose-home/
# Anthropic API key for Goose (not for the gateway)
.env.goose
# Article draft, not public until published
doc/article-draft.md
